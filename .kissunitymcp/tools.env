# Per-project tool configuration. DATA, not a shell script: no expansion/eval.
# Use KEY=value or KEY="value". Absolute native or Unix paths; spaces supported.
# Empty values use platform defaults. Environment overrides take precedence.
# Unity version always comes from ProjectSettings/ProjectVersion.txt.
UNITY_HUB_EDITOR_ROOT=
UNITY_EDITOR_PATH=
# Point RIDER_ROOT at the application directory (Rider.app on macOS).
RIDER_ROOT=
# Optional explicit executable/launcher, or MSBuild.dll plus MSBUILD_RUNTIME.
RIDER_MSBUILD=
MSBUILD_RUNTIME=
UNITY_SOLUTION_PATH=
# Examples:
# Windows: UNITY_HUB_EDITOR_ROOT=C:/Program Files/Unity/Hub/Editor
# Windows: RIDER_ROOT=C:/Program Files/JetBrains/JetBrains Rider 2025.1.4
# macOS:   UNITY_HUB_EDITOR_ROOT=/Applications/Unity/Hub/Editor
# macOS:   RIDER_ROOT=/Applications/Rider.app
# Linux:   UNITY_HUB_EDITOR_ROOT=/home/you/Unity/Hub/Editor
# Linux:   RIDER_ROOT=/opt/JetBrains/Rider
# For .dll: MSBUILD_RUNTIME=<absolute path to Rider's compatible dotnet host>
# A .dll needs its matching runtime and reference assemblies, supplied by your
# Unity/Rider toolchain. Setup never downloads or installs an SDK/runtime.
